{
  "contract_version": "1.0",
  "commands": [
    {
      "command_type": "CreateReviewItem",
      "capability": "review.item.create",
      "idempotent": true,
      "payload_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["project_ref_id", "item_code", "title", "original_file_id", "responsible_editor_id", "responsible_editor_name_snapshot", "local_probe_claim"],
        "properties": {
          "project_ref_id": {"type": "string", "minLength": 1},
          "item_code": {"type": "string", "minLength": 1, "maxLength": 128},
          "episode_no": {"type": "integer", "minimum": 1},
          "title": {"type": "string", "minLength": 1, "maxLength": 512},
          "original_file_id": {"type": "string", "minLength": 1},
          "responsible_editor_id": {"type": "string", "minLength": 1},
          "responsible_editor_name_snapshot": {"type": "string", "minLength": 1, "maxLength": 255},
          "local_probe_claim": {"$ref": "#/definitions/local_media_probe_claim"},
          "version_note": {"type": "string"}
        }
      }
    },
    {
      "command_type": "UpdateReviewItem",
      "capability": "review.item.update",
      "idempotent": false,
      "payload_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["project_ref_id", "review_item_id"],
        "properties": {
          "project_ref_id": {"type": "string", "minLength": 1},
          "review_item_id": {"type": "string", "minLength": 1},
          "episode_no": {"type": "integer", "minimum": 1},
          "title": {"type": "string", "minLength": 1, "maxLength": 512}
        }
      }
    },
    {
      "command_type": "DeleteReviewItem",
      "capability": "review.item.delete",
      "idempotent": true,
      "payload_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["project_ref_id", "review_item_id", "confirmed"],
        "properties": {
          "project_ref_id": {"type": "string", "minLength": 1},
          "review_item_id": {"type": "string", "minLength": 1},
          "confirmed": {"type": "boolean", "const": true}
        }
      }
    },
    {
      "command_type": "DeleteReviewItemsBatch",
      "capability": "review.item.delete",
      "idempotent": true,
      "payload_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["project_ref_id", "review_item_ids", "confirmed"],
        "properties": {
          "project_ref_id": {"type": "string", "minLength": 1},
          "review_item_ids": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1}
          },
          "confirmed": {"type": "boolean", "const": true}
        }
      }
    },
    {
      "command_type": "UploadReviewVersion",
      "capability": "review.version.upload",
      "idempotent": true,
      "payload_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["project_ref_id", "review_item_id", "original_file_id", "responsible_editor_id", "responsible_editor_name_snapshot", "local_probe_claim"],
        "properties": {
          "project_ref_id": {"type": "string", "minLength": 1},
          "review_item_id": {"type": "string", "minLength": 1},
          "original_file_id": {"type": "string", "minLength": 1},
          "responsible_editor_id": {"type": "string", "minLength": 1},
          "responsible_editor_name_snapshot": {"type": "string", "minLength": 1, "maxLength": 255},
          "local_probe_claim": {"$ref": "#/definitions/local_media_probe_claim"},
          "version_note": {"type": "string"},
          "change_summary": {"type": "string"},
          "supersede_reason": {"type": "string"}
        }
      }
    }
  ],
  "definitions": {
    "local_media_probe_claim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fps_num", "fps_den", "is_variable_frame_rate", "probe_version"],
      "properties": {
        "fps_num": {"type": "integer", "minimum": 1},
        "fps_den": {"type": "integer", "minimum": 1},
        "is_variable_frame_rate": {"type": "boolean", "const": false},
        "probe_version": {"type": "string", "minLength": 1, "maxLength": 64}
      },
      "x-allowed-rational-frame-rates": [[24000, 1001], [24, 1], [25, 1], [30000, 1001], [30, 1], [50, 1], [60000, 1001], [60, 1]]
    }
  }
}
